# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in. Nothing here belongs in git.
#
# Both models are any OpenAI-compatible /v1 endpoint (vLLM, SGLang,
# llama.cpp server, hosted API). They are referenced from config/*.yaml
# as ${...} placeholders, expanded at load time — so no hostname ever
# needs to live in the repository.
# ─────────────────────────────────────────────────────────────

# The "student": asks the questions, judges the answers, merges responses.
# Prefer a different model family from the teacher — same-model grading is
# self-play and makes the correctness dimension meaningless.
STUDENT_BASE_URL=http://your-student-host:8000/v1
STUDENT_API_KEY=
STUDENT_MODEL=your-student-model

# The "teacher": produces the answers that become training data.
TEACHER_BASE_URL=http://your-teacher-host:8000/v1
TEACHER_API_KEY=
TEACHER_MODEL=your-teacher-model

# Optional extra teachers (multi-teacher merge). Leave blank to skip —
# a teacher whose base_url is empty is disabled at load.
TEACHER2_BASE_URL=
TEACHER3_BASE_URL=
TEACHER4_BASE_URL=
TEACHER5_BASE_URL=
TEACHER6_BASE_URL=

# Infrastructure
DISTILL_REDIS_URL=redis://localhost:6379/0

# Optional overrides (any Config field works as DISTILL_<UPPER_NAME>)
# DISTILL_DATASET_BASE_PATH=/root/datasets
# DISTILL_MIN_QUALITY_SCORE=0.68
# DISTILL_MAX_QUESTIONS_PER_TOPIC=30
# DISTILL_NUM_ANSWER_WORKERS=8
